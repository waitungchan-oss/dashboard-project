{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P3 monthly analytics snapshot",
  "type": "object",
  "required": [
    "version",
    "period",
    "sampleSize",
    "metrics",
    "branchRanking",
    "destinationDemand",
    "sentiment",
    "customerValueChain",
    "sourceRefs",
    "calculationNotes"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "period": { "type": "string", "pattern": "^20[0-9]{4}$" },
    "sampleSize": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/metric" }
    },
    "branchRanking": {
      "type": "array",
      "items": { "$ref": "#/$defs/rankingRow" }
    },
    "destinationDemand": {
      "type": "array",
      "items": { "$ref": "#/$defs/rankingRow" }
    },
    "sentiment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "count", "rate"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 },
          "rate": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    },
    "customerValueChain": {
      "type": "object",
      "required": ["status", "stages", "links", "unavailable"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable"] },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/$defs/valueChainStage" }
        },
        "links": {
          "type": "array",
          "items": { "type": "object" }
        },
        "unavailable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "sourceRefs": { "type": "array" },
    "calculationNotes": { "type": "array" }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["value", "unit", "n", "definition"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string", "minLength": 1 },
        "n": { "type": "integer", "minimum": 0 },
        "definition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "rankingRow": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "sourceRef": {
      "type": "object",
      "required": ["kind", "month", "path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "month": { "type": "string", "pattern": "^20[0-9]{4}$" },
        "path": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "recordKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "valueChainStage": {
      "type": "object",
      "required": ["key", "value", "unit", "n", "sourceRefs"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string", "null"] },
        "unit": { "type": "string", "minLength": 1 },
        "n": { "type": "integer", "minimum": 0 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
