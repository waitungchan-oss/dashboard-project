{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dashboard month manifest",
  "type": "object",
  "required": ["defaultMonth", "months"],
  "properties": {
    "defaultMonth": { "type": "string", "pattern": "^20[0-9]{4}$" },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "schema", "status"],
        "properties": {
          "key": { "type": "string", "pattern": "^20[0-9]{4}$" },
          "label": { "type": "string", "minLength": 1 },
          "schema": { "enum": ["current", "legacy"] },
          "status": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
